generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserType {
  BUYER
  FARMER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String   @id @default(uuid())
  userType     UserType @map("user_type")
  email        String   @unique
  phone        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  buyer  Buyer?
  farmer Farmer?

  @@map("users")
}

model Buyer {
  id         String   @id @map("id")
  latitude   Decimal? @db.Decimal(10, 8)
  longitude  Decimal? @db.Decimal(11, 8)
  address    String?
  city       String?
  department String?
  createdAt  DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [id], references: [id], onDelete: Cascade)
  orders Order[] @relation("BuyerOrders")

  @@map("buyers")
}

model Farmer {
  id              String         @id @map("id")
  farmName        String         @map("farm_name")
  farmDescription String?        @map("farm_description")
  latitude        Decimal        @db.Decimal(10, 8)
  longitude       Decimal        @db.Decimal(11, 8)
  address         String
  city            String
  department      String
  farmPhotos      Json?          @map("farm_photos")
  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  bankName        String?        @map("bank_name")
  accountType     String?        @map("account_type")
  accountNumber   String?        @map("account_number")
  createdAt       DateTime       @default(now()) @map("created_at")

  user     User      @relation(fields: [id], references: [id], onDelete: Cascade)
  products Product[]
  orders   Order[]   @relation("FarmerOrders")

  @@map("farmers")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  iconName  String?  @map("icon_name")
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  farmerId    String   @map("farmer_id")
  categoryId  Int?     @map("category_id")
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  unit        String
  stock       Int      @default(0)
  isAvailable Boolean  @default(true) @map("is_available")
  images      Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  farmer     Farmer      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([farmerId])
  @@index([categoryId])
  @@index([isAvailable])
  @@map("products")
}

model Order {
  id                   String        @id @default(uuid())
  orderNumber          String        @unique @map("order_number")
  buyerId              String        @map("buyer_id")
  farmerId             String        @map("farmer_id")
  status               OrderStatus   @default(PENDING)
  subtotal             Decimal       @db.Decimal(10, 2)
  deliveryCost         Decimal       @default(0) @map("delivery_cost") @db.Decimal(10, 2)
  commission           Decimal       @db.Decimal(10, 2)
  total                Decimal       @db.Decimal(10, 2)
  paymentMethod        String        @map("payment_method")
  paymentStatus        PaymentStatus @default(PENDING) @map("payment_status")
  deliveryAddress      String        @map("delivery_address")
  deliveryCity         String        @map("delivery_city")
  deliveryPhone        String        @map("delivery_phone")
  deliveryInstructions String?       @map("delivery_instructions")
  notes                String?
  wompiTransactionId   String?       @map("wompi_transaction_id")
  paidAt               DateTime?     @map("paid_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  buyer  Buyer       @relation("BuyerOrders", fields: [buyerId], references: [id])
  farmer Farmer      @relation("FarmerOrders", fields: [farmerId], references: [id])
  items  OrderItem[]

  @@index([buyerId])
  @@index([farmerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  productName String   @map("product_name")
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2) @map("unit_price")
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}
